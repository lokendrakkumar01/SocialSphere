# ==============================================================================
# SocialSphere Environment Configuration (.env.example)
# ==============================================================================

# Server Network & App Identification
PORT=5000
NODE_ENV=development
APP_NAME=SocialSphere
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB URI or leave default for in-memory fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/socialsphere

# Cryptographic Token Keys (Generate secure random 64-character strings for production)
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Media Uploads & Storage Policy
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Client Vite Configuration
VITE_API_URL=http://localhost:5000/api/v1
VITE_WS_URL=http://localhost:5000
