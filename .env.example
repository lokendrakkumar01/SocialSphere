# ==============================================================================
# SocialSphere Environment Configuration (.env.example)
# ==============================================================================

# Server Network & App Identification
PORT=5000
NODE_ENV=production
APP_NAME=SocialSphere
CLIENT_URL=https://your-frontend-subdomain.onrender.com

# Database Connection (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/socialsphere?retryWrites=true&w=majority

# Cryptographic Token Keys (Generate secure random 64-character strings for production)
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Media Uploads & Storage Policy
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=pkqwgvat
CLOUDINARY_API_KEY=876913628793746
CLOUDINARY_API_SECRET=uOMBWmIOlkqhzFOJg6gHzfD5nxY

# Admin Secret Passcode (Used during registration to create an Admin account)
ADMIN_REGISTRATION_KEY=Admin@SocialSphere2026

# Client Vite Configuration (Set in client build environment)
VITE_API_URL=https://your-backend-subdomain.onrender.com/api/v1
VITE_WS_URL=https://your-backend-subdomain.onrender.com
